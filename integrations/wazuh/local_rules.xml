<!--
  RetroHound findings in Wazuh. Input: the output of `retrohound scan` in the ndjson-ecs format, one JSON object per line, read by the
  agent with <log_format>json</log_format> (see localfile.xml). No custom decoder: Wazuh's built-in JSON decoder
  ("json") extracts every key, nested keys as dotted names (event.severity, rule.name, ...).
  Install: append to /var/ossec/etc/rules/local_rules.xml (or save as its own file in /var/ossec/etc/rules/),
  restart wazuh-manager, then paste a line into /var/ossec/bin/wazuh-logtest to check the match.
  IDs 100800-100805, inside Wazuh's custom range 100000-120000. Change them if they clash with your own rules.
  event.severity is the Sigma level as 1 to 5 (docs/output-schema.md).
-->
<group name="retrohound,ai_coding_agent,">

  <rule id="100800" level="0">
    <decoded_as>json</decoded_as>
    <field name="event.module">^retrohound$</field>
    <field name="event.kind">^alert$</field>
    <description>RetroHound finding (grouping rule)</description>
  </rule>

  <!-- informational -->
  <rule id="100801" level="3">
    <if_sid>100800</if_sid>
    <field name="event.severity">^1$</field>
    <description>RetroHound informational: $(rule.name): $(message)</description>
  </rule>

  <!-- low -->
  <rule id="100802" level="5">
    <if_sid>100800</if_sid>
    <field name="event.severity">^2$</field>
    <description>RetroHound low: $(rule.name): $(message)</description>
  </rule>

  <!-- medium -->
  <rule id="100803" level="8">
    <if_sid>100800</if_sid>
    <field name="event.severity">^3$</field>
    <description>RetroHound medium: $(rule.name): $(message)</description>
  </rule>

  <!-- high -->
  <rule id="100804" level="12">
    <if_sid>100800</if_sid>
    <field name="event.severity">^4$</field>
    <description>RetroHound high: $(rule.name): $(message)</description>
  </rule>

  <!-- critical -->
  <rule id="100805" level="14">
    <if_sid>100800</if_sid>
    <field name="event.severity">^5$</field>
    <description>RetroHound critical: $(rule.name): $(message)</description>
  </rule>

</group>
